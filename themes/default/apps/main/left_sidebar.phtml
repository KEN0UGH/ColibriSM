			<script>
			(function($){
				$(document).ready(function(){
					$('#alt-accounts-toggle').on('click', function(e){
						$('#alt-accounts-dropdown').toggleClass('d-none');
					});
				});
			})(jQuery);

			function loginAltAccount(alt_id){
				if (!alt_id || alt_id == 0) return;
				$.post("<?php echo cl_link("native_api/settings/login_alt_account"); ?>", {alt_id: alt_id, hash: "<?php echo fetch_or_get($cl['csrf_token'],'none'); ?>"}, function(data){
					if (data.status == 200) {
						cl_bs_notify("<?php echo cl_translate("alternate_account_logged_in_successfully"); ?>", 5000, "success");
						window.location.reload();
					} else {
						cl_bs_notify("<?php echo cl_translate("Something went wrong while trying to switch accounts, please try again later"); ?>", 5000, "danger");
					}
				}, 'json');
			}
