<script>
    "use strict";

    $(document).ready(function($) {
        Vue.use(window.vuelidate.default);
        var VueValids = window.validators;

        new Vue({
            el: "#cl-alt-accounts-settings-vue-app",
            data: {
                submitting: false,
                unsuccessful_attempt: false,
                alt_locked: false,
                alt_password_wrong: false,
                lock_message: "",
                remaining_seconds: 0,
                countdown_interval: null,
                invalid_feedback_alt_identifier: "",
                invalid_feedback_alt_password: "",
                alt_identifier: "",
                alt_password: "",
                password_display: "password"
            },
            computed: {
                is_invalid_alt_identifier: function() {
                    if (this.$v.alt_identifier.$error) {
                        this.invalid_feedback_alt_identifier = "<?php echo cl_translate("Please enter a username or email address."); ?>";
                        return true;
                    }
                    this.invalid_feedback_alt_identifier = "";
                    return false;
                },
                is_invalid_alt_password: function() {
                    if (this.$v.alt_password.$error) {
                        this.invalid_feedback_alt_password = "<?php echo cl_translate("Please enter the password for the alternate account."); ?>";
                        return true;
                    }
                    this.invalid_feedback_alt_password = "";
                    return false;
                }
            },
            validations: {
                alt_identifier: {
                    required: VueValids.required,
                    minLength: VueValids.minLength(3),
                    maxLength: VueValids.maxLength(60)
                },
                alt_password: {
                    required: VueValids.required,
                    minLength: VueValids.minLength(6),
                    maxLength: VueValids.maxLength(20)
                }
            },
            methods: {
                submit_form: function(_self) {
                    _self.preventDefault();
                    var _app_ = this;

                    $(_self.target).ajaxSubmit({
                        url: "<?php echo cl_link("native_api/settings/save_alt_account"); ?>",
                        type: 'POST',
                        dataType: 'json',
                        beforeSend: function() {
                            _app_.submitting = true;
                            _app_.unsuccessful_attempt = false;
                            _app_.alt_locked = false;
                            _app_.alt_password_wrong = false;
                            _app_.lock_message = "";
                            _app_.remaining_seconds = 0;
                        },
                        success: function(data) {
                            if (data.status == 200) {
                                cl_bs_notify("<?php echo cl_translate("Alternate account added successfully"); ?>", 5000, "success");
                                window.location.reload();
                            } else {
                                // Check for specific error codes
                                if (data.err_code == 'alt_add_locked') {
                                    _app_.alt_locked = true;
                                    _app_.lock_message = data.message || "<?php echo cl_translate('Too many failed attempts. Try again later.'); ?>";
                                    if (data.lock_until) {
                                        _app_.remaining_seconds = Math.max(0, Math.ceil((data.lock_until - Math.floor(Date.now() / 1000))));
                                        _app_.start_countdown();
                                    }
                                }
                                else if (data.err_code == 'invalid_alt_account') {
                                    _app_.alt_password_wrong = true;
                                }
                                else {
                                    _app_.unsuccessful_attempt = true;
                                }
                            }
                        },
                        complete: function() {
                            _app_.submitting = false;
                        }
                    });
                },

                password_display_toggle: function() {
                    this.password_display = (this.password_display == 'password') ? 'text' : 'password';
                },

                start_countdown: function() {
                    var _app_ = this;
                    if (_app_.countdown_interval) {
                        clearInterval(_app_.countdown_interval);
                    }
                    _app_.countdown_interval = setInterval(function() {
                        _app_.remaining_seconds--;
                        if (_app_.remaining_seconds <= 0) {
                            clearInterval(_app_.countdown_interval);
                            _app_.countdown_interval = null;
                            _app_.alt_locked = false;
                            _app_.remaining_seconds = 0;
                        }
                    }, 1000);
                },

                remove_alt_account: function(alt_id) {
                    if (!alt_id || alt_id == 0) return;

                    var _app_ = this;

                    $.post("<?php echo cl_link("native_api/settings/remove_alt_account"); ?>", {
                        alt_id: alt_id,
                        hash: "<?php echo fetch_or_get($cl['csrf_token'],'none'); ?>"
                    }, function(data) {
                        if (data.status == 200) {
                            cl_bs_notify("<?php echo cl_translate("Alternate account removed successfully"); ?>", 5000, "success");
                            window.location.reload();
                        } else {
                            _app_.unsuccessful_attempt = true;
                        }
                    }, 'json');
                },

                login_alt_account: function(alt_id) {
                    if (!alt_id || alt_id == 0) return;

                    var _app_ = this;

                    $.post("<?php echo cl_link("native_api/settings/login_alt_account"); ?>", {
                        alt_id: alt_id,
                        hash: "<?php echo fetch_or_get($cl['csrf_token'],'none'); ?>"
                    }, function(data) {
                        if (data.status == 200) {
                            cl_bs_notify("<?php echo cl_translate("alternate_account_logged_in_successfully"); ?>", 5000, "success");
                            window.location.reload();
                        } else {
                            _app_.unsuccessful_attempt = true;
                        }
                    }, 'json');
                }
            }
        });
    });
</script>